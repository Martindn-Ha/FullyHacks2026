# Server
PORT=3000

# Required: Google Cloud API key used from this Node server (header X-Goog-Api-Key) with:
# Places API (New) enabled, billing on, Nearby Search (New) allowed for the key.
# Application restrictions: use "None" while developing, or "IP addresses" for a server—
# NOT "iOS apps" / "Android apps" / "HTTP referrers" (those block server-side Node).
GOOGLE_MAPS_API_KEY=

# Optional for local Google testing: if unset, recommendations use generic placeholder text per place
# (sources.guidance = "placeholder"). Set URL for real Human Delta retrieval.
# When set: POST { query, places: { id, name, vicinity? }[] }; response items/results must
# include every requested Google place id with at least one non-empty passage.text.
# Official search endpoint (see Human Delta API Reference — Base https://api.humandelta.ai):
# HUMAN_DELTA_API_URL=https://api.humandelta.ai/v1/search
HUMAN_DELTA_API_URL=
# Optional: sent as Authorization: Bearer <key> when set.
HUMAN_DELTA_API_KEY=
