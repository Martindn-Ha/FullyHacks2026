# Server
PORT=3000

# ML regression bundle (POST /api/spike-risk): Python runs ml_model/infer_glucose_regression_json.py.
# Recommended (PEP 668): python3 -m venv ml_model/.venv && ml_model/.venv/bin/pip install -r ml_model/requirements.txt
# The server auto-uses ml_model/.venv when present. Override with:
# ML_MODEL_PYTHON=/path/to/python3
# ML_MODEL_INFER_SCRIPT=/absolute/path/to/ml_model/infer_glucose_regression_json.py
# ML_MODEL_INFER_TIMEOUT_MS=25000
# Legacy names still work: SPIKE_PYTHON, SPIKE_INFER_SCRIPT, SPIKE_INFER_TIMEOUT_MS

# Dev only: set to true so /api/recommendations always runs (no low-risk empty response) and risk shows moderate+.
# Remove or set false before shipping.
DEV_BYPASS_LOW_RISK_RECOMMENDATIONS_GATE=

# Required: Google Cloud API key used from this Node server (header X-Goog-Api-Key) with:
# Places API (New) enabled, billing on, Nearby Search (New) allowed for the key.
# Application restrictions: use "None" while developing, or "IP addresses" for a server—
# NOT "iOS apps" / "Android apps" / "HTTP referrers" (those block server-side Node).
GOOGLE_MAPS_API_KEY=

# Human Delta — see Human_delta_rest_api.txt. Official POST /v1/search supports query, top_k, sources, index_id.
# HUMAN_DELTA_API_URL=https://api.humandelta.ai/v1/search
HUMAN_DELTA_API_URL=
HUMAN_DELTA_API_KEY=
# After POST /v1/indexes completes, set the returned id so search hits your crawl (omit = search all org indexes).
HUMAN_DELTA_INDEX_ID=
# Optional: 1–20 (default 10 in code). More chunks → richer context for Gemini.
HUMAN_DELTA_TOP_K=
# Optional: corpora — e.g. documents or documents,web (omit = both). Uploaded files need "documents".
HUMAN_DELTA_SOURCES=

# Required for POST /api/recommendations when Google returns nearby places: Gemini runs every time.
# Request shape: https://cloud.google.com/vertex-ai/generative-ai/docs/model-reference/inference
# API keys (express): https://cloud.google.com/vertex-ai/generative-ai/docs/start/api-keys
GEMINI_USE_VERTEX=true
VERTEX_GEMINI_API_KEY=
# Required when GEMINI_USE_VERTEX=true — GCP project id or numeric project id (Console home / error JSON).
GEMINI_VERTEX_PROJECT_ID=
GEMINI_VERTEX_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
# Optional: venues per Gemini call for menu synthesis (default 4). Lower if PLACE_BEGIN blocks are still dropped.
# GEMINI_SYNTHESIS_PLACES_PER_CALL=3
# Google AI Studio: set GEMINI_USE_VERTEX=false (project id not required); use a Studio key.
